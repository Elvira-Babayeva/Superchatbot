# Copy to .env (python run.py reads it automatically; real environment variables win). Defaults = offline mock data.
# Real mode switches on by itself when the key is present and the SUPERCHAT_* line is absent.

# --- Flights: Aviasales (Travelpayouts Data API). Free token: https://www.travelpayouts.com
AVIASALES_TOKEN=
AVIASALES_MARKER=
AVIASALES_CURRENCY=usd

# --- Shopping: mock | dummyjson (free demo shop, no key) | generic (your shop; needs ECOMMERCE_BASE_URL)
SUPERCHAT_PRODUCTS=dummyjson
ECOMMERCE_BASE_URL=
ECOMMERCE_SEARCH_PATH=/products/search
ECOMMERCE_QUERY_PARAM=q
ECOMMERCE_TOKEN=
ECOMMERCE_RATE=1                # price currency -> AZN
ECOMMERCE_FIELDS={}             # JSON overrides of the field map, e.g. {"items":"data.items","name":"title"}

# --- Cinema: CinemaPlus. ENDPOINTS/FIELDS ARE UNVERIFIED until you have the partner documentation (see README)
CINEMAPLUS_BASE_URL=
CINEMAPLUS_TOKEN=
CINEMAPLUS_AUTH_HEADER=Authorization   # or X-Api-Key ...
CINEMAPLUS_AUTH_SCHEME=Bearer          # empty for a raw key
CINEMAPLUS_AUTH_QUERY=                 # e.g. apikey  -> ?apikey=<token> instead of a header
CINEMAPLUS_CONFIG=                     # path to a JSON file: {"endpoints": {...}, "fields": {...}, "auth_header": "..."}
CINEMAPLUS_ENDPOINTS={}
CINEMAPLUS_FIELDS={}

# --- Visual search: Claude Vision
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
VS_CONFIDENT=0.75               # >= this: answer directly, show the confidence
VS_MIN=0.40                     # between VS_MIN and VS_CONFIDENT: show results AND ask "is that right?"; below VS_MIN: do not search, ask
VS_AMBIGUOUS_GAP=0.15           # two candidates closer than this: ask which one

# --- Failure policy when a real API is down: error (friendly message) | mock (serve mock data)
SUPERCHAT_FALLBACK=error

# --- Diagnostics / safety
SUPERCHAT_DEBUG=1               # show the real failure reason in chat (e.g. "HTTP 401: invalid x-api-key"); 0 for production
SUPERCHAT_HOST=127.0.0.1        # localhost only (the server holds paid keys). 0.0.0.0 exposes it to your network - add authentication first
SUPERCHAT_PHOTOS_PER_MIN=10     # per-client limit for photo searches (each one is a paid Claude call)
